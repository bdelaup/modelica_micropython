within MicroPythonMCU;
package Sandbox "Bricolage / expérimentation libre, hors périmètre de la bibliothèque (non couvert par les scénarios de vérification de requirements.md)"
  extends Modelica.Icons.Package;

  annotation(
    Documentation(info = "<html>
<p>Espace libre pour évaluer des idées directement dans l'arborescence Modelica de la bibliothèque (classes, connexions, essais de composants), sans convention particulière à respecter ni garantie de stabilité. Rien ici n'est couvert par les scénarios de vérification de <code>requirements.md</code> ; ce qui doit être conservé durablement doit en sortir (<code>Examples/</code>, etc.).</p>
</html>"));
end Sandbox;
