within MicroPythonMCU.Examples;
package MicroBit "Examples with the micro:bit v2 board: LED matrix, buttons, edge pins"
  extends Modelica.Icons.ExamplesPackage;
  annotation(
    Documentation(info = "<html>
<p>Models using <code>MicroPythonMCU.MicroBit_v2</code>: the 5x5 LED matrix, the A/B buttons and the edge pins, driven by MicroPython programs written for the official <code>microbit</code> module API (they run unchanged on a physical micro:bit).</p>
</html>"));
end MicroBit;
