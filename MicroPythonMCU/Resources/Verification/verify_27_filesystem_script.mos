// Scénario de vérification v0 n°27 (cf. requirements.md, décision « Système de fichiers »).
// omc verify_27_filesystem_script.mos   (depuis ce dossier)
loadModel(Modelica); getErrorString();
loadFile("../../package.mo"); getErrorString();

// Copies laissées par un run précédent interrompu : on repart d'un dossier propre.
system("for /d %d in (mcu_datalogger_*) do rmdir /s /q \"%d\"");

// fsOpenExplorer désactivé : pas de fenêtre d'Explorateur pendant la vérification.
simulate(MicroPythonMCU.Examples.FileSystem.Script, stopTime = 0.5, numberOfIntervals = 500, fileNamePrefix = "FileSystemScript", simflags = "-override=mcu.fsOpenExplorer=false");
b := getErrorString();

// Le script allume GP1 si boot.py a tourné (/data existe) et main.py non (/data vide).
vLed := val(mcu.GP1.v, 0.4, "FileSystemScript_res.mat");

system("dir /b /ad /o:n mcu_datalogger_* > fs_copies.txt");
copies := OpenModelica.Scripting.strtok(readFile("fs_copies.txt"), "\r\n");
nCopies := size(copies, 1);
notesOk := nCopies == 1 and regularFileExists(copies[1] + "/data/notes.txt") and not regularFileExists(copies[1] + "/data/measurements.csv");

system("for /d %d in (mcu_datalogger_*) do rmdir /s /q \"%d\"");
deleteFile("fs_copies.txt");

if vLed > 2.0 and notesOk then
  print("PASS: verify_27_filesystem_script (boot.py puis script a la place de main.py : GP1(led)=" + String(vLed) + "V, notes.txt ecrit, pas de measurements.csv)\n");
else
  print("FAIL: verify_27_filesystem_script (GP1(led)=" + String(vLed) + "V, copies=" + String(nCopies) + ", fichiers conformes=" + String(notesOk) + ")\n" + b);
end if;
