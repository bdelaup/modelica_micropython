// Scénario de vérification n°27 (cf. requirements.md, décision « Système de fichiers »).
// omc verify_27_filesystem_script.mos   (depuis ce dossier)
loadModel(Modelica); getErrorString();
loadFile("../../package.mo"); getErrorString();
loadString("model FsScriptVerify
  extends MicroPythonMCU.Examples.FileSystem.Script(mcu(fsWorkspace = \"FsScriptVerify_ws\"));
end FsScriptVerify;"); getErrorString();

// Copies laissées par un run précédent interrompu : on repart d'un dossier propre.
system(if getEnvironmentVar("OS") == "Windows_NT" then "if exist FsScriptVerify_ws rmdir /s /q FsScriptVerify_ws" else "rm -rf -- ./FsScriptVerify_ws");

// fsOpenExplorer désactivé : pas de fenêtre d'Explorateur pendant la vérification.
simulate(FsScriptVerify, stopTime = 0.5, numberOfIntervals = 500, fileNamePrefix = "FileSystemScript", simflags = "-override=mcu.fsOpenExplorer=false");
b := getErrorString();

// Le script allume GP1 si boot.py a tourné (/data existe) et main.py non (/data vide).
vLed := val(mcu.GP1.v, 0.4, "FileSystemScript_res.mat");

system(if getEnvironmentVar("OS") == "Windows_NT" then "dir /b /ad /o:n FsScriptVerify_ws > FsScriptVerify_copies.txt" else "ls -1 -- FsScriptVerify_ws > FsScriptVerify_copies.txt");
copies := OpenModelica.Scripting.strtok(readFile("FsScriptVerify_copies.txt"), "\r\n");
nCopies := size(copies, 1);
notesOk := nCopies == 1 and regularFileExists("FsScriptVerify_ws/" + copies[1] + "/data/notes.txt") and not regularFileExists("FsScriptVerify_ws/" + copies[1] + "/data/measurements.csv");

system(if getEnvironmentVar("OS") == "Windows_NT" then "if exist FsScriptVerify_ws rmdir /s /q FsScriptVerify_ws" else "rm -rf -- ./FsScriptVerify_ws");
deleteFile("FsScriptVerify_copies.txt");

if vLed > 2.0 and notesOk then
  print("PASS: verify_27_filesystem_script (boot.py puis script a la place de main.py : GP1(led)=" + String(vLed) + "V, notes.txt ecrit, pas de measurements.csv)\n");
else
  print("FAIL: verify_27_filesystem_script (GP1(led)=" + String(vLed) + "V, copies=" + String(nCopies) + ", fichiers conformes=" + String(notesOk) + ")\n" + b);
end if;
