// Scénario de vérification n°8 (cf. requirements.md).
// omc verify_07_adc_read.mos   (depuis ce dossier)
loadModel(Modelica); getErrorString();
loadFile("../../package.mo"); getErrorString();

simulate(MicroPythonMCU.Examples.Adc.Read, stopTime = 1, numberOfIntervals = 1000, fileNamePrefix = "AdcRead");
b := getErrorString();

vTap := val(mcu.GP1.v, 0.05, "AdcRead_res.mat");
// LED relevee a t=0.1 s, AVANT la 2e lecture (t=0.2 s) : elle ne peut etre
// allumee que si la toute premiere lecture, a t=0, a vu les 2,2 V du pont.
// Avant le multi-instances (2026-10-01), cette lecture voyait 0 V (etat
// electrique pas encore etabli au premier point de synchro) et le scenario
// relevait la LED a t=0.3 s ; la coupure par pre() des sorties publiees a
// leve ce defaut, que ce releve garde sous controle - cf. requirements.md,
// TODO « Lectures justes des t=0 ».
vLed := val(mcu.GP0.v, 0.1, "AdcRead_res.mat");

if vTap > 1.5 and vTap < 3.0 and vLed > 2.0 then
  print("PASS: verify_07_adc_read (GP1(ADC)=" + String(vTap) + "V, GP0(led)=" + String(vLed) + "V)\n");
else
  print("FAIL: verify_07_adc_read (GP1(ADC)=" + String(vTap) + "V, GP0(led)=" + String(vLed) + "V)\n" + b);
end if;
