// Scénario de vérification n°25 (cf. requirements.md, décision « Système de fichiers »).
// omc verify_25_filesystem.mos   (depuis ce dossier)
loadModel(Modelica); getErrorString();
loadFile("../../package.mo"); getErrorString();
loadString("model FsBootVerify
  extends MicroPythonMCU.Examples.FileSystem.Boot(mcu(fsWorkspace = \"FsBootVerify_ws\"));
end FsBootVerify;"); getErrorString();

// Copies laissées par un run précédent interrompu : on repart d'un dossier propre.
system(if getEnvironmentVar("OS") == "Windows_NT" then "if exist FsBootVerify_ws rmdir /s /q FsBootVerify_ws" else "rm -rf -- ./FsBootVerify_ws");

// Deux simulations successives : chacune doit créer SA copie horodatée de
// l'image dans un espace de travail réservé à ce scénario, et
// les deux doivent produire exactement les mêmes fichiers (déterminisme).
// fsOpenExplorer désactivé : pas de fenêtre d'Explorateur pendant la vérification.
simulate(FsBootVerify, stopTime = 1.5, numberOfIntervals = 1500, fileNamePrefix = "FileSystem", simflags = "-override=mcu.fsOpenExplorer=false");
b1 := getErrorString();
simulate(FsBootVerify, stopTime = 1.5, numberOfIntervals = 1500, fileNamePrefix = "FileSystem", simflags = "-override=mcu.fsOpenExplorer=false");
b2 := getErrorString();

// main.py allume GP1 si son auto-contrôle (relecture, listdir, stat, "..") passe.
vLed := val(mcu.GP1.v, 1.4, "FileSystem_res.mat");

system(if getEnvironmentVar("OS") == "Windows_NT" then "dir /b /ad /o:n FsBootVerify_ws > FsBootVerify_copies.txt" else "ls -1 -- FsBootVerify_ws > FsBootVerify_copies.txt");
copies := OpenModelica.Scripting.strtok(readFile("FsBootVerify_copies.txt"), "\r\n");
nCopies := size(copies, 1);
m1 := if nCopies >= 1 then readFile("FsBootVerify_ws/" + copies[1] + "/data/measurements.csv") else "";
m2 := if nCopies >= 2 then readFile("FsBootVerify_ws/" + copies[2] + "/data/measurements.csv") else "";
nLines := size(OpenModelica.Scripting.strtok(m1, "\n"), 1);
// ".." s'arrête à la racine de la flash : le fichier est dans la copie, pas au-dessus.
escapeOk := nCopies >= 1 and regularFileExists("FsBootVerify_ws/" + copies[1] + "/outside_flash.txt") and not regularFileExists("FsBootVerify_ws/outside_flash.txt") and not regularFileExists("outside_flash.txt");
// L'image d'origine n'est jamais modifiée.
sourceOk := regularFileExists("../FileSystems/datalogger/main.py") and not directoryExists("../FileSystems/datalogger/data") and not regularFileExists("../FileSystems/datalogger/outside_flash.txt");

// Nettoyage : ne pas laisser les copies dans le dépôt.
system(if getEnvironmentVar("OS") == "Windows_NT" then "if exist FsBootVerify_ws rmdir /s /q FsBootVerify_ws" else "rm -rf -- ./FsBootVerify_ws");
deleteFile("FsBootVerify_copies.txt");

if vLed > 2.0 and nCopies == 2 and nLines == 11 and m1 == m2 and escapeOk and sourceOk then
  print("PASS: verify_25_filesystem (GP1(led)=" + String(vLed) + "V, 2 copies, " + String(nLines - 1) + " mesures identiques, cloisonnement OK, source intacte)\n");
else
  print("FAIL: verify_25_filesystem (GP1(led)=" + String(vLed) + "V, copies=" + String(nCopies) + ", lignes=" + String(nLines) + ", identiques=" + String(m1 == m2) + ", cloisonnement=" + String(escapeOk) + ", source intacte=" + String(sourceOk) + ")\n" + b1 + b2);
end if;
