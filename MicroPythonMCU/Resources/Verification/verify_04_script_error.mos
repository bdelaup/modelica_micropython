// Scénario de vérification v0 n°4 (cf. requirements.md).
// omc verify_04_script_error.mos   (depuis ce dossier)
loadModel(Modelica); getErrorString();
loadFile("../../package.mo"); getErrorString();

simulate(MicroPythonMCU.Examples.Program.Error, stopTime = 5, fileNamePrefix = "ScriptError");
getErrorString();

// Le résultat de simulate() n'est pas lisible depuis un .mos (r.resultFile
// introuvable), et getErrorString() n'est pas un critère : il peut être vide
// alors que la simulation a échoué. L'ancien critère « getErrorString() non
// vide » ne passait que grâce à l'avertissement d'initialisation présent dans
// toute simulation, disparu depuis que les valeurs de départ sont explicites.
// On relance donc l'exécutable par son .bat (qui positionne le PATH), on garde
// son code de sortie et son journal, et on y cherche la trace Python et le
// message du runtime. Le code doit valoir exactement -1 (arrêt propre d'OpenModelica
// sur erreur) : -1073741819 (0xC0000005) signalerait le retour du plantage que
// contourne Library = "-lwinpthread" (cf. requirements.md, décision « Comportement
// en cas d'exception non gérée dans le script »).
ret := system(".\\ScriptError.bat", "ScriptError_run.txt");
log := readFile("ScriptError_run.txt");
(nTrace, m1) := regex(log, "ZeroDivisionError", 1);
(nRuntime, m2) := regex(log, "le script a leve une exception non geree", 1);

if ret == -1 and nTrace >= 1 and nRuntime >= 1 then
  print("PASS: verify_04_script_error (simulation arretee proprement en erreur : code de sortie " + String(ret) + ", ZeroDivisionError et message du runtime dans le journal)\n");
else
  print("FAIL: verify_04_script_error (code de sortie " + String(ret) + ", ZeroDivisionError trouve " + String(nTrace) + " fois, message du runtime " + String(nRuntime) + " fois)\n--- journal ---\n" + log);
end if;
