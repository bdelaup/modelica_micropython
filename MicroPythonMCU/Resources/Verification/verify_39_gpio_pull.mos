// Scénario de vérification v0 n°39 : tirages internes (Examples.Gpio.Pull).
// omc verify_39_gpio_pull.mos   (depuis ce dossier)
//
// Ce que ce scénario vérifie : Pin(n, mode, pull) branche réellement une
// résistance de 50 kOhm. GP0 (bouton vers la masse, PULL_UP) et GP3 (bouton
// vers 3,3 V, PULL_DOWN) n'ont aucune résistance externe et donnent pourtant
// des niveaux francs, recopiés sur GP6/GP7. GP4 n'a qu'une résistance de 1 MOhm
// vers 3,3 V : sans tirage, la vraie haute impédance la laisse gagner ; avec le
// tirage bas, le diviseur donne 0,16 V ; avec le tirage haut, 3,3 V.
loadModel(Modelica); getErrorString();
loadFile("../../package.mo"); getErrorString();

simulate(MicroPythonMCU.Examples.Gpio.Pull, stopTime = 1, numberOfIntervals = 1000, fileNamePrefix = "GpioPull");
b := getErrorString();

f := "GpioPull_res.mat";

// --- GP0 : PULL_UP, bouton vers la masse appuyé de 0,1 à 0,2 s ---
vUpReleased := val(mcu.GP0.v, 0.05, f);
vUpPressed := val(mcu.GP0.v, 0.15, f);
ledUpOff := val(mcu.GP6.v, 0.05, f);
ledUpOn := val(mcu.GP6.v, 0.15, f);

// --- GP3 : PULL_DOWN, bouton vers 3,3 V appuyé de 0,4 à 0,5 s ---
vDownReleased := val(mcu.GP3.v, 0.35, f);
vDownPressed := val(mcu.GP3.v, 0.45, f);
ledDownOff := val(mcu.GP7.v, 0.35, f);
ledDownOn := val(mcu.GP7.v, 0.45, f);

// --- GP4 : 1 MOhm vers 3,3 V ; sans tirage, puis tirage bas, puis tirage haut ---
vNoPull := val(mcu.GP4.v, 0.2, f);
vPullDown := val(mcu.GP4.v, 0.5, f);
vPullUp := val(mcu.GP4.v, 0.9, f);

okUp := vUpReleased > 3.2 and vUpPressed < 0.1 and ledUpOff < 0.5 and ledUpOn > 2.0;
okDown := vDownReleased < 0.1 and vDownPressed > 3.2 and ledDownOff < 0.5 and ledDownOn > 2.0;
okWeak := vNoPull > 3.2 and vPullDown > 0.1 and vPullDown < 0.3 and vPullUp > 3.2;

if okUp and okDown and okWeak then
  print("PASS: verify_39_gpio_pull (GP0 " + String(vUpReleased) + "/" + String(vUpPressed) + "V ; GP3 " + String(vDownReleased) + "/" + String(vDownPressed) + "V ; GP4 " + String(vNoPull) + "/" + String(vPullDown) + "/" + String(vPullUp) + "V)\n");
else
  print("FAIL: verify_39_gpio_pull (GP0 " + String(vUpReleased) + "/" + String(vUpPressed) + " led " + String(ledUpOff) + "/" + String(ledUpOn) + " ; GP3 " + String(vDownReleased) + "/" + String(vDownPressed) + " led " + String(ledDownOff) + "/" + String(ledDownOn) + " ; GP4 " + String(vNoPull) + "/" + String(vPullDown) + "/" + String(vPullUp) + ")\n" + b);
end if;
