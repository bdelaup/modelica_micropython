within MicroPythonMCU;
package Utils "Composants couramment utilisés dans les montages (LED, ...)"
  extends Modelica.Icons.Package;

  annotation(
    Documentation(info = "<html>
<p>Composants électriques réutilisables entre montages (<code>Examples/</code>, essais dans <code>Sandbox</code>), en complément des composants standards <code>Modelica.Electrical.Analog</code>. Contrairement à <code>Sandbox</code>, ce qui est ici est destiné à être stable et réutilisé.</p>
</html>"));
end Utils;
